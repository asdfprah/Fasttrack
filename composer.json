{
    "name": "vifrost/laravel",
    "description": "Easily build API with Laravel Framework",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Vifrost\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vifrost\\Laravel\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Jorge Fuentes",
            "email": "j.fuentes.delaguarda@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/container": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "spatie/laravel-query-builder": "^6.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vifrost\\Laravel\\Providers\\VifrostServiceProvider"
            ]
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.7",
        "orchestra/testbench": "^10.0|^11.1",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest"
    }
}
