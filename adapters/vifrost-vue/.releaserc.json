{
  "branches": ["master"],
  "tagFormat": "vifrost-vue-v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "release": false },
          { "scope": "vue", "type": "feat", "release": "minor" },
          { "scope": "vue", "type": "fix", "release": "patch" },
          { "scope": "vue", "type": "perf", "release": "patch" },
          { "scope": "vue", "breaking": true, "release": "major" }
        ]
      }
    ],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    "@semantic-release/npm",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "cd .. && npm install --package-lock-only"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "../package-lock.json", "CHANGELOG.md"],
        "message": "chore(vue): release v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
