{
  "branches": ["master"],
  "tagFormat": "vifrost-codegen-v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "release": false },
          { "scope": "codegen", "type": "feat", "release": "minor" },
          { "scope": "codegen", "type": "fix", "release": "patch" },
          { "scope": "codegen", "type": "perf", "release": "patch" },
          { "scope": "codegen", "breaking": true, "release": "major" }
        ]
      }
    ],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    "@semantic-release/npm",
    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "CHANGELOG.md"],
        "message": "chore(release): @vifrost/codegen v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
